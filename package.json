{
  "name": "dual-pet",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build.mjs",
    "tauri:build:windows": "tauri build --bundles nsis",
    "tauri:build:mac": "node scripts/build.mjs --target x86_64-apple-darwin --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
