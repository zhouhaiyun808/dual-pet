{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dual Pet",
  "version": "0.3.0",
  "identifier": "com.haiyunzhou.dualpet",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet-a",
        "title": "陈子奚",
        "url": "index.html",
        "width": 196,
        "height": 212,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "pet-b",
        "title": "江晏",
        "url": "index.html",
        "width": 196,
        "height": 212,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
